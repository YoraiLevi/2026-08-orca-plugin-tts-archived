{
  "name": "orca-tts-workspace",
  "private": true,
  "type": "module",
  "bin": {
    "orca-tts": "scripts/orca-tts.mjs"
  },
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint packages scripts",
    "build": "node scripts/build.mjs",
    "size-gate": "node scripts/size-gate.mjs",
    "check:mutants": "node scripts/mutation-check.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "bench:latency": "node scripts/bench-latency.mjs",
    "probe:numbers": "node scripts/ci/number-ceiling-probe.mjs",
    "bench:lab-gate": "node scripts/bench-lab-gate.mjs",
    "probe:ui": "node scripts/ui-probe.mjs",
    "voice-lab": "node scripts/voice-lab.mjs",
    "control": "node scripts/orca-tts.mjs control"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
