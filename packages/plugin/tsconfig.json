{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@orca-tts/core": [
        "../core/src/index.ts"
      ],
      "@orca-tts/providers": [
        "../providers/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../providers"
    }
  ]
}
